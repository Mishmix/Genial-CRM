# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
PORTFOLIO_URL=https://example.com/portfolio
AUTO_REPLY_ENABLED=true

# Admin Access (comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Browser Admin Password (bcrypt hash)
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/X4.VTtYWWQIqjSXXe

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./crm.db

# Session Secret
SESSION_SECRET=change_this_to_random_secret_key_min_32_chars

# Webhook (for production)
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook

# Environment
ENV=development
