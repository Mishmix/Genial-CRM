# Railway Environment Variables for Backend
# Copy these to Railway dashboard -> Variables

# Telegram Bot
TELEGRAM_BOT_TOKEN=8537924648:AAG25YSjHJWLjiEkS0uqBVks513JR6Z_RMs

# Admin access
ADMIN_TELEGRAM_IDS=1470411356
ADMIN_PASSWORD_HASH=demo

# Groq API (for AI features)
GROQ_API_KEY=your_groq_api_key_here

# CORS - add your frontend Railway URL here
CORS_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173

# Database (Railway provides this automatically for PostgreSQL)
# DATABASE_URL=postgresql://...

# For SQLite (simpler, but data won't persist on redeploy)
DATABASE_URL=sqlite:///./crm.db

# Session secret (generate a random string)
SESSION_SECRET=change_this_to_a_random_32_char_string_here

# Environment
ENV=production

# Webhook (Railway will provide the URL)
# WEBHOOK_URL=https://your-backend.up.railway.app/telegram/webhook
